# =============================================================================
# TEST ENVIRONMENT — BDD / Integration Tests
# Mirrors .env.development with test-specific overrides.
# =============================================================================

NODE_ENV=test

APP_NAME=referral-pulse-tenant-svc
APP_PORT=5002
APP_API_PREFIX=api
APP_MODE=server

ALLOWED_ORIGINS=http://localhost:3000

INVITATION_EXPIRY_DAYS=7
TRIAL_DURATION_DAYS=14
FRONTEND_DOMAIN=http://localhost:3000

# =============================================================================
# DATABASE
# =============================================================================

DATABASE_URL=postgresql://root:root@localhost:5432/tenants
DATABASE_MAX_CONNECTIONS=5
DATABASE_LOGGING=false

# =============================================================================
# REDIS
# =============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=test:tenant:

REDIS_TLS_ENABLED=false
REDIS_IAM_AUTH_ENABLED=false
REDIS_IAM_AUTH_USERNAME=default
REDIS_CLUSTER_ENABLED=false
REDIS_MAX_RETRIES_PER_REQUEST=3
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_RETRY_DELAY_MS=50
REDIS_MAX_RETRY_DELAY_MS=2000
REDIS_DEFAULT_TTL=3600
REDIS_LOCK_TTL=30000

# =============================================================================
# AUTHENTICATION
# AUTH_CACHE_ENABLED=false is CRITICAL — forces jwks-rsa to re-fetch per token
# so that nock intercepts every JWKS call.
# =============================================================================

AUTH_JWKS_URI=http://localhost:4444/.well-known/jwks.json
AUTH_ISSUER=http://localhost:4444/
AUTH_AUDIENCE=test-audience
AUTH_ALGORITHMS=RS256
AUTH_CLOCK_TOLERANCE=30
AUTH_CACHE_ENABLED=false
AUTH_CACHE_TTL=60
AUTH_TENANT_HEADER=x-tenant-id
AUTH_TENANT_CLAIM_PATH=ext.tenant_id

# =============================================================================
# ORY STACK (intercepted by nock in tests)
# =============================================================================

ORY_HYDRA_PUBLIC_URL=http://localhost:4444
ORY_HYDRA_ISSUER=http://localhost:4444/
ORY_KETO_READ_URL=http://localhost:4466
ORY_KETO_WRITE_URL=http://localhost:4467
ORY_KRATOS_ADMIN_URL=http://localhost:4434
ORY_KRATOS_PUBLIC_URL=http://localhost:4433
JWT_AUDIENCE=test-audience

# =============================================================================
# AWS (LocalStack — not used in tests, SQS polling disabled)
# =============================================================================

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT=http://127.0.0.1:4566

# =============================================================================
# SQS / SNS (polling disabled in tests)
# =============================================================================

SQS_QUEUES=campaign-svc.fifo|http://127.0.0.1:4566/000000000000/campaign-svc.fifo,tenant-svc.fifo|http://127.0.0.1:4566/000000000000/tenant-svc.fifo,reward-svc.fifo|http://127.0.0.1:4566/000000000000/reward-svc.fifo,referral-svc.fifo|http://127.0.0.1:4566/000000000000/referral-svc.fifo,notification-webhook-svc.fifo|http://127.0.0.1:4566/000000000000/notification-webhook-svc.fifo,analytics-svc.fifo|http://127.0.0.1:4566/000000000000/analytics-svc.fifo,audit-trail.fifo|http://127.0.0.1:4566/000000000000/audit-trail.fifo
SQS_DEFAULT_BATCH_SIZE=10
SQS_DEFAULT_VISIBILITY_TIMEOUT=30
SQS_DEFAULT_WAIT_TIME_SECONDS=20
SQS_POLLING_ENABLED=false

SNS_TOPICS=billing-events-topic|arn:aws:sns:us-east-1:000000000000:billing-events-topic

# =============================================================================
# S3 / SES
# =============================================================================

S3_BUCKET_NAME=referral-pulse-test
S3_PRESIGNED_URL_EXPIRY=900
S3_UPLOAD_PART_SIZE=5242880
S3_MAX_CONCURRENT_UPLOADS=4
AWS_SES_FROM_EMAIL=noreply@test.com

# =============================================================================
# HTTP CLIENT
# =============================================================================

HTTP_CLIENT_TIMEOUT=3000
HTTP_CLIENT_MAX_REDIRECTS=5
HTTP_CLIENT_RETRY_ATTEMPTS=0
HTTP_CLIENT_RETRY_DELAY=200
HTTP_CLIENT_RETRY_MAX_DELAY=2000
HTTP_CLIENT_RETRY_EXPONENTIAL=false
HTTP_INTERNAL_SERVICE_DOMAINS=*.svc.cluster.local
INTRA_HTTP_TIMEOUT_MS=3000

# =============================================================================
# CIRCUIT BREAKER
# =============================================================================

CIRCUIT_BREAKER_ENABLED=false
CIRCUIT_BREAKER_FAILURE_THRESHOLD=10
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=2
CIRCUIT_BREAKER_MONITORING_PERIOD=10000
CIRCUIT_BREAKER_TIMEOUT=5000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT=5000
CIRCUIT_BREAKER_VOLUME_THRESHOLD=20
CIRCUIT_BREAKER_MAX_CACHE_SIZE=100

# =============================================================================
# INTER-SERVICE URLs
# =============================================================================

SERVICE_TENANTS_URL=http://localhost:5002
SERVICE_CAMPAIGNS_URL=http://localhost:5003
SERVICE_REWARDS_URL=http://localhost:5004
SERVICE_ANALYTICS_URL=http://localhost:5005
SERVICE_TRACKING_URL=http://localhost:5006
SERVICE_REFERRALS_URL=http://localhost:5007
SERVICE_SDK_CONFIG_URL=http://localhost:5008
SERVICE_CONTENT_AI_URL=http://localhost:5009
SERVICE_CLIENT_IDENTITY_URL=http://localhost:5010
SERVICE_WORKFLOW_ORCHESTRATION_URL=http://localhost:5011

# =============================================================================
# STRIPE (intercepted by nock in billing scenarios)
# =============================================================================

STRIPE_SECRET_KEY=sk_test_bdd_placeholder
STRIPE_FREE_PRODUCT_ID=prod_test_free
STRIPE_STARTER_PRODUCT_ID=prod_test_starter
STRIPE_GROWTH_PRODUCT_ID=prod_test_growth
STRIPE_ENTERPRISE_PRODUCT_ID=prod_test_enterprise
STRIPE_WEBHOOK_SECRET=whsec_test_placeholder
STRIPE_SUCCESS_URL=http://localhost:5002/success
STRIPE_CANCEL_URL=http://localhost:5002/cancel
STRIPE_FREE_PRICE_ID=price_test_free
STRIPE_STARTER_PRICE_ID=price_test_starter
STRIPE_GROWTH_PRICE_ID=price_test_growth
STRIPE_ENTERPRISE_PRICE_ID=price_test_enterprise

# =============================================================================
# BILLING
# =============================================================================

BILLING_PLAN_STRIPE_SYNC_ENABLED=false

# =============================================================================
# OBSERVABILITY (all disabled in tests)
# =============================================================================

OTEL_ENABLED=false
OTEL_SERVICE_NAME=referral-pulse-tenant-svc-test
OTEL_SERVICE_VERSION=1.0.0
OTEL_SERVICE_NAMESPACE=test
OTEL_SAMPLING_RATIO=0
OTEL_PROPAGATE_B3=false
OTEL_PROPAGATE_W3C=false
OTEL_LOG_LEVEL=error

LOKI_ENABLED=false
LOKI_LABELS={"job":"referral-pulse-tenant-svc","environment":"test"}
LOKI_BATCH_INTERVAL=5000

# =============================================================================
# TEMPORAL
# =============================================================================

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=referral-task-queue

# =============================================================================
# CLICKHOUSE (not used in tests)
# =============================================================================

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_PROTOCOL=http
