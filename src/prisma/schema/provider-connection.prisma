/// A tenant's credentialed link to an external provider (v5.2 API §3.16, DB Model §3 `connections`): billing
/// (inbound webhooks), payout (outbound + status callbacks), CRM (both), Zapier (outbound via webhook subscriptions).
///
/// The row's `id` is the `{connection_id}` in ingestion's `/inbound/{provider}/{connection_id}`: the path names the
/// tenant and the secret, so no callback is attributed by anything the caller asserts.
model ProviderConnection {
  id       String @id @default(ulid()) @db.VarChar(26)
  tenantId String @map("tenant_id") @db.VarChar(26)

  /// stripe, paddle, chargebee, paypal, wise, tremendous, hubspot, salesforce, zapier (`crm` survives only on revoked rows).
  provider  String @db.VarChar(20)
  /// inbound | outbound | both, fixed by the provider matrix.
  direction String @db.VarChar(10)
  /// pending_verification → active (first verified callback or successful outbound test) → revoked.
  status    String @default("pending_verification") @db.VarChar(24)
  /// Operator-facing label; not in the v5.2 contract, kept from v5.1.
  name      String? @db.VarChar(100)

  /// Outbound credentials (`api_key` / `oauth_code`) as sealed JSON. AES-256-GCM with the provider-secret key until
  /// the KMS envelope lands (US1.5.4); never returned by the API, opened only for the test and the audited credential route.
  credentialsEncrypted           String?   @map("credentials_encrypted") @db.Text
  /// The inbound webhook secret (Chargebee: `user:password`), sealed the same way.
  signingSecretEncrypted         String?   @map("signing_secret_encrypted") @db.Text
  /// The rotated-out signing secret, honoured until `previous_secret_valid_until` (24 h, v5.2 API §3.16).
  previousSigningSecretEncrypted String?   @map("previous_signing_secret_encrypted") @db.Text
  previousSecretValidUntil       DateTime? @map("previous_secret_valid_until") @db.Timestamptz

  /// Provider settings that are not secrets — PayPal `clientId`/`webhookId`/`environment`, Chargebee `allowedIps`.
  config Json @default("{}")

  lastVerifiedAt DateTime? @map("last_verified_at") @db.Timestamptz
  lastSyncAt     DateTime? @map("last_sync_at") @db.Timestamptz

  createdBy String?   @map("created_by") @db.VarChar(26)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  /// Soft delete per DB Model §0.4: a revoked connection's receipts must stay attributable.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// One live connection per tenant per provider; the partial uniqueness is in the migration SQL
  /// (`idx_connections_live`), because a revoked row must not block a replacement.
  @@index([tenantId, provider, status], map: "idx_connections_tenant_provider")
  @@map("connections")
}
