model ApiKey {
  id         String    @id @default(ulid()) @db.VarChar(26)
  tenantId   String    @map("tenant_id") @db.VarChar(26)
  label      String    @db.VarChar(255)
  // HMAC-SHA256(API_KEY_HASH_PEPPER, raw key), hex — deterministic, so validation is one indexed lookup.
  keyHash    String    @unique @map("key_hash") @db.VarChar(64)
  // Last 4 characters of the raw key: the only part ever shown in dashboards or logs (API §8.3).
  keyPrefix  String    @map("key_prefix") @db.Char(4)
  // text + CHECK: secret | publishable (DB Model v2 §3)
  keyType    String    @default("secret") @map("key_type") @db.VarChar(20)
  createdBy  String    @map("created_by") @db.VarChar(26)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, keyPrefix])
  @@index([tenantId, revokedAt])
  @@map("api_keys")
}