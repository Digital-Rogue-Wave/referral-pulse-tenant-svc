// Request idempotency for non-ingestion POST/PATCH (API Contract v1.3 §1, DB Model v2 §0.7).
// Keyed per principal scope + key for 24 h; stores the original response so a retry gets it back verbatim.
model IdempotencyKey {
  // The caller's scope: the tenant id, or `identity:{id}` / `service:{client}` for tenant-less callers.
  tenantId           String   @map("tenant_id") @db.VarChar(80)
  idempotencyKey     String   @map("idempotency_key") @db.VarChar(255)
  // SHA-256 of method + path + body: the same key with a different request is a 409, not a replay.
  requestFingerprint String   @map("request_fingerprint") @db.Char(64)
  // Null while the first request is still running.
  responseStatus     Int?     @map("response_status") @db.SmallInt
  responseBody       Json?    @map("response_body")
  targetResourceId   String?  @map("target_resource_id") @db.VarChar(64)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt          DateTime @map("expires_at") @db.Timestamptz

  @@id([tenantId, idempotencyKey])
  @@index([expiresAt], map: "idx_idem_expiry")
  @@map("idempotency_keys")
}
