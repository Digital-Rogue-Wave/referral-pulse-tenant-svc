enum EffectType {
  sqs
  sns
  email
  audit
}

model SideEffectOutbox {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id") @db.VarChar(26)
  effectType     EffectType @map("effect_type")
  status         String    @default("pending") @db.VarChar(50)
  aggregateType  String    @map("aggregate_type") @db.VarChar(100)
  aggregateId    String    @map("aggregate_id") @db.VarChar(26)
  eventType      String    @map("event_type") @db.VarChar(100)
  payload        Json
  metadata       Json?
  scheduledAt    DateTime  @default(now()) @map("scheduled_at") @db.Timestamptz
  retryCount     Int       @default(0) @map("retry_count")
  maxRetries     Int       @default(3) @map("max_retries")
  lastError      String?   @map("last_error") @db.Text
  processedAt    DateTime? @map("processed_at") @db.Timestamptz
  idempotencyKey String?   @map("idempotency_key") @db.VarChar(255)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@index([status, scheduledAt])
  @@index([tenantId, status])
  @@index([aggregateType, aggregateId])
  @@map("side_effect_outbox")
}
