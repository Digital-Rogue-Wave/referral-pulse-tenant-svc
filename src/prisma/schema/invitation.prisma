model Invitation {
  id        String   @id @default(ulid()) @db.VarChar(26)
  tenantId  String   @map("tenant_id") @db.VarChar(26)
  email     String   @db.VarChar(255)
  role      String   @default("OPERATOR") @db.VarChar(50)
  status    String   @default("PENDING") @db.VarChar(50)
  // SHA-256 of the invitation token. The token itself is only ever in the invitee's email link.
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([email])
  @@map("invitations")
}