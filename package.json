{
    "name": "referral-campaign-service",
    "version": "1.0.0",
    "description": "Production-ready NestJS microservice for campaign management",
    "author": "ReferralAI",
    "private": true,
    "license": "MIT",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "prebuild": "rimraf dist",
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "pnpm:dedupe": "pnpm dedupe",
        "pnpm:update": "pnpm update --latest",
        "clean": "rimraf dist node_modules coverage",
        "clean:install": "pnpm clean && pnpm install"
    },
    "engines": {
        "node": ">=22.15.0",
        "pnpm": ">=10.0.0"
    },
    "packageManager": "pnpm@10.0.0",
    "dependencies": {
        "@aws-crypto/sha256-js": "^5.2.0",
        "@aws-sdk/client-s3": "^3.987.0",
        "@aws-sdk/client-ses": "^3.987.0",
        "@aws-sdk/client-sns": "^3.987.0",
        "@aws-sdk/client-sqs": "^3.987.0",
        "@aws-sdk/credential-provider-node": "^3.972.6",
        "@aws-sdk/lib-storage": "^3.987.0",
        "@aws-sdk/s3-request-presigner": "^3.987.0",
        "@clickhouse/client": "^1.17.0",
        "@faker-js/faker": "^10.3.0",
        "@nestjs/axios": "^4.0.1",
        "@nestjs/common": "^11.1.13",
        "@nestjs/config": "^4.0.3",
        "@nestjs/core": "^11.1.13",
        "@nestjs/event-emitter": "^3.0.1",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/mapped-types": "^2.1.0",
        "@nestjs/microservices": "^11.1.13",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.13",
        "@nestjs/schedule": "^6.1.1",
        "@nestjs/swagger": "^11.2.6",
        "@nestjs/terminus": "^11.0.0",
        "@nestjs/throttler": "^6.5.0",
        "@opentelemetry/api": "^1.9.0",
        "@opentelemetry/core": "^2.5.0",
        "@opentelemetry/exporter-metrics-otlp-http": "^0.211.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.211.0",
        "@opentelemetry/instrumentation-aws-sdk": "^0.66.0",
        "@opentelemetry/instrumentation-express": "^0.59.0",
        "@opentelemetry/instrumentation-http": "^0.211.0",
        "@opentelemetry/instrumentation-ioredis": "^0.59.0",
        "@opentelemetry/instrumentation-pg": "^0.63.0",
        "@opentelemetry/propagator-b3": "^2.5.0",
        "@opentelemetry/resources": "^2.5.0",
        "@opentelemetry/sdk-metrics": "^2.5.0",
        "@opentelemetry/sdk-node": "^0.211.0",
        "@opentelemetry/semantic-conventions": "^1.39.0",
        "@prisma/adapter-pg": "^7.4.0",
        "@prisma/client": "^7.4.0",
        "@sindresorhus/slugify": "^3.0.0",
        "@smithy/protocol-http": "^5.3.8",
        "@smithy/signature-v4": "^5.3.8",
        "@ssut/nestjs-sqs": "^3.0.1",
        "axios": "^1.13.5",
        "bcryptjs": "^3.0.3",
        "bullmq": "^5.67.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.3",
        "compression": "^1.8.1",
        "eventemitter2": "^6.4.9",
        "helmet": "^8.1.0",
        "hpp": "^0.2.3",
        "ioredis": "^5.9.2",
        "json-rules-engine": "^7.3.1",
        "jwks-rsa": "^3.2.2",
        "lru-cache": "^11.2.6",
        "moment": "^2.30.1",
        "moment-timezone": "^0.6.0",
        "nestjs-i18n": "^10.6.0",
        "nestjs-pino": "^4.5.0",
        "opossum": "^9.0.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.18.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "pino-loki": "^3.0.0",
        "pino-pretty": "^13.1.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "simdjson": "^0.9.2",
        "sinon": "^21.0.1",
        "stripe": "^20.4.0",
        "ulid": "^3.0.2",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@nestjs/cli": "^11.0.16",
        "@nestjs/schematics": "^11.0.9",
        "@nestjs/testing": "^11.1.13",
        "@swc/cli": "^0.6.0",
        "@swc/core": "^1.15.11",
        "@swc/jest": "^0.2.39",
        "@types/compression": "^1.8.1",
        "@types/express": "^5.0.6",
        "@types/hpp": "^0.2.7",
        "@types/jest": "^30.0.0",
        "@types/multer": "^2.0.0",
        "@types/multer-s3": "^3.0.3",
        "@types/node": "^25.2.3",
        "@types/opossum": "^8.1.9",
        "@types/passport-jwt": "^4.0.1",
        "@types/pg": "^8.16.0",
        "@types/sinon": "^21.0.0",
        "@types/supertest": "^6.0.3",
        "@typescript-eslint/eslint-plugin": "^8.55.0",
        "@typescript-eslint/parser": "^8.55.0",
        "dotenv": "^17.3.1",
        "eslint": "^9.15.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-promise": "^7.2.1",
        "eslint-plugin-security": "^3.0.1",
        "eslint-plugin-sonarjs": "^3.0.6",
        "jest": "^30.2.0",
        "jest-mock-extended": "^4.0.0",
        "madge": "^8.0.0",
        "multer-s3": "^3.0.1",
        "nock": "^14.0.11",
        "node-gyp": "^12.2.0",
        "prettier": "^3.8.1",
        "prisma": "^7.4.0",
        "rimraf": "^6.1.2",
        "source-map-support": "^0.5.21",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.6",
        "ts-loader": "^9.5.4",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.55.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "moduleNameMapper": {
            "^@app/(.*)$": "<rootDir>/$1",
            "^@domains/(.*)$": "<rootDir>/domains/$1",
            "^@common/(.*)$": "<rootDir>/common/$1",
            "^@config/(.*)$": "<rootDir>/config/$1",
            "^@config$": "<rootDir>/config",
            "^@prisma-gen/(.*)$": "<rootDir>/prisma/$1"
        }
    },
    "prisma": {
        "seed": "tsx src/prisma/seed.ts"
    }
}
